# Copy this file to .env and fill in your values.
# .env is git-ignored, so your real key never gets committed.

# From https://build.nvidia.com — starts with nvapi-
NVIDIA_API_KEY=nvapi-your-key-here

# Local Postgres, started with: docker compose up -d
DATABASE_URL=postgresql://northwind:local-development-only@127.0.0.1:5433/support

# Signs the session cookie that identifies a visitor.
# Must stay the same across restarts — changing it invalidates every
# existing session. Use a long random value in production.
SECRET_KEY=change-me-to-something-random
