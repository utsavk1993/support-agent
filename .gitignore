# Secrets — never commit real keys
.env

# Python virtual environment
.venv/
venv/

# Python bytecode cache
__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Built client — produced by `npm run build`, not committed.
# Committing build output means every change shows up twice in a diff.
static/

# Node
web/node_modules/
web/dist/

# Coverage output — regenerated by every test run, and published by CI as
# a job summary and a downloadable artifact. The numbers are enforced by
# the thresholds in pyproject.toml and vite.config.ts; the reports are for
# reading, not for keeping.
.coverage
coverage.json
coverage.xml
htmlcov/
web/coverage/

# Tool caches
.pytest_cache/
.ruff_cache/
*.tsbuildinfo
